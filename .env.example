# Server-only Spotify credentials. Never prefix these with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Added to .env.local by npm run spotify:connect after owner authorization.
SPOTIFY_REFRESH_TOKEN=

# Server-only MyAnimeList client ID, used to read TheSwiginator's public lists.
# Public list reads do not require the client secret or an OAuth token.
MAL_CLIENT_ID=
# Required only for visitor recommendations. mal:connect saves the refresh token.
MAL_CLIENT_SECRET=
MAL_REFRESH_TOKEN=
